create_clock -name rgmii_rxc -period 8.000 -waveform {0.000 4.000} [get_ports {rgmii_rxc}]
create_clock -name rgmii_txc -period 8.000 -waveform {0.000 4.000} [get_ports {rgmii_txc}]
# 网络域逻辑时钟: 直接命名 PLL 输出, 与 cfg_clk 同一套路
create_clock -name net_clk [get_pins u_net_pll/u_gpll:CLKOUT0] -period 8.000 -waveform {0.000 4.000} -add

# 网络域逻辑时钟是 PLL 派生的 Inferred 时钟, 必须用 -of_objects 引用, 否则 false_path 不生效
set_false_path -from [get_clocks {pixclk_in}] -to [get_clocks {net_clk}]
set_false_path -from [get_clocks {net_clk}] -to [get_clocks {pixclk_in}]
set_false_path -from [get_clocks {cfg_clk}] -to [get_clocks {net_clk}]
set_false_path -from [get_clocks {net_clk}] -to [get_clocks {cfg_clk}]
