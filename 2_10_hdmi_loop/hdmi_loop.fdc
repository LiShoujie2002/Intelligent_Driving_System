# ============================================================================
#  时序约束
#  【注意】当前为 720p 调试阶段, pixclk_in 周期用 13.468ns (74.25MHz)。
#         之后切回 1080p 时, 把下面 pixclk_in 的 period 改回 6.734ns 即可。
# ============================================================================
create_clock -name pixclk_in -period 13.468 -waveform {0.000 6.734} [get_ports {pixclk_in}]
create_clock -name sys_clk   -period 37.037 [get_ports {sys_clk}]

# ---- PLL 输出 cfg_clk (10MHz) ----
# 【语法坑】Pango 引用原语引脚必须用 "实例:引脚" 的冒号形式, 不能用层次路径
#           的斜杠形式, 否则报 Timing-4003 "Pin not found"。下面这条是 Pango
#           自己生成约束时的写法, 直接照抄。
create_clock -name cfg_clk [get_pins u_pll/u_gpll:CLKOUT0] -period 100.000 -waveform {0.000 50.000} -add

# ---- 输出侧: 转发时钟与数据之间的 pad 到 pad 偏斜 ----
# pixclk_out 是把 pixclk_in 转发出去的, 两者在焊盘上的延迟差必须钉住,
# 否则 MS7210 采样窗口会偏。这里用 pad 到 pad 的 max_delay 直接约束。
set_max_delay 8.400 -from [get_ports {pixclk_in}] -to [get_ports {r_out[*] g_out[*] b_out[*] de_out hs_out vs_out}]
set_max_delay 7.000 -from [get_ports {pixclk_in}] -to [get_ports {pixclk_out}]

# ---- 输入侧: MS7200 时钟到数据的输出延迟 ----
# 数值为估算(MS7200 输出数据相对像素时钟约有 3ns 延迟), 最终以数据手册 tCO 为准。
set_input_delay -clock pixclk_in -max 4.500 [get_ports {r_in[*] g_in[*] b_in[*] de_in hs_in vs_in}]
set_input_delay -clock pixclk_in -min 3.000 [get_ports {r_in[*] g_in[*] b_in[*] de_in hs_in vs_in}]

# ---- 跨时钟域 ----
# init_over 由 10MHz 的 cfg_clk 域产生, RTL 里已做两级同步, 故声明为异步。
# 这里引用的是上面自己命名的 cfg_clk, 不能用 Pango 自动推断的名字
# (形如 sys_clk|u_pll/u_gpll/CLKOUT0_Inferred, 导入阶段还不存在)。
# 软核(cfg_clk) 与 视频流水线(pixk_in) 之间只交换准静态信号, 两边都在 RTL 里
# 做了两级同步, 所以两个方向都按异步处理, 不做时序检查。
# 不加这条的话, pixclk_in -> cfg_clk 会有 41 个端点的建立违例 (那是同步器第一级,
# 属于故意跨域, 不是真问题)。
set_false_path -from [get_clocks {cfg_clk}] -to [get_clocks {pixclk_in}]
set_false_path -from [get_clocks {pixclk_in}] -to [get_clocks {cfg_clk}]

# ============================================================================
#  串口 (接板载 CP2102 USB-UART, 供 PicoRV32 软核打印调试信息)
#  MES2L676-200HP 硬件使用手册 3.2.5 节: RXD=B24, TXD=C24
# ============================================================================
define_attribute {p:uart_rxd} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:uart_rxd} {PAP_IO_LOC} {B24}
define_attribute {p:uart_rxd} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_rxd} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_rxd} {PAP_IO_NONE} {TRUE}

define_attribute {p:uart_txd} {PAP_IO_DIRECTION} {OUTPUT}
